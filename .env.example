# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored on purpose: never commit real API keys.

# Chat LLM (OpenAI-compatible). Default below = DeepSeek official.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# Other providers (swap BASE_URL + MODEL_NAME if needed):
# Official OpenAI: https://api.openai.com/v1  +  gpt-4o-mini
# DashScope:       https://dashscope.aliyuncs.com/compatible-mode/v1  +  deepseek-v4.1-flash
# Local (Ollama):  http://localhost:11434/v1  +  your local model name

# Embedding / RAG (DashScope). Not used by the chat LLM.
DASHSCOPE_API_KEY=

# Web search, no API key required. "bing" = live via Bing HTML page (default,
# most reliable from CN networks); "duckduckgo" = live via DuckDuckGo HTML
# endpoint (may show a bot-check page); "mock" = fixed offline placeholder.
WEB_SEARCH_BACKEND=bing

# Observability (LangSmith tracing). Optional: LangChain/LangGraph read these
# variables automatically at runtime; leave LANGCHAIN_API_KEY empty to run
# fully locally without uploading traces.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=AI-Learning-Assistant
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
