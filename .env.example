# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored on purpose: never commit real API keys.

# API key of your OpenAI-compatible provider.
OPENAI_API_KEY=

# Base URL of the OpenAI-compatible endpoint.
# Official OpenAI: https://api.openai.com/v1
# DeepSeek:        https://api.deepseek.com/v1
# Local (Ollama):  http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Chat model name used by the agent, e.g. gpt-4o-mini / deepseek-chat.
MODEL_NAME=gpt-4o-mini